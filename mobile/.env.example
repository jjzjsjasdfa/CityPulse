# Android 模拟器使用 10.0.2.2；真机请替换为开发电脑的局域网 IP。
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# 唯一地图提供方：高德 JS API 2.0（网页、iOS、Android 共用）
# Web 端 JS API Key，不是后端地点查询的 Web 服务 Key。
EXPO_PUBLIC_AMAP_JS_KEY=
# 官方安全代理完整地址，例如 https://maps.example.com/_AMapService
# securityJsCode 只保存在代理服务器，不可放进 EXPO_PUBLIC_*。
EXPO_PUBLIC_AMAP_SERVICE_HOST=
# 可选：在高德样式编辑器发布的样式 ID；留空使用 whitesmoke。
EXPO_PUBLIC_AMAP_STYLE_ID=

# 测试 API 自动使用 Expo 开发电脑地址，通常无需填写。
# 使用 tunnel 或自定义服务时，填写手机可直接访问的完整 API 地址。
# EXPO_PUBLIC_DEMO_API_URL=http://192.168.2.49:18082/api/v1
