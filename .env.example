POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
# Local Docker development credentials. Use a secret value in production and
# change both this password and the password embedded in DATABASE_URL together.
POSTGRES_PASSWORD=citypulse-dev
DATABASE_URL=postgresql+psycopg://citypulse:citypulse-dev@db:5432/citypulse
BACKEND_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optionally append your real project contact email or URL.
INGESTION_USER_AGENT=CityPulse/0.1
INGESTION_ON_STARTUP=true
# Optional: your own Amap Web Service key for city + venue-name lookup.
# Showstart detail addresses/times/coordinates do not require this key.
AMAP_API_KEY=
